{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BMW Pong",
  "version": "1.0.0",
  "identifier": "com.bmw.pong",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BMW Pong",
        "width": 1280,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "backgroundColor": "#0b0d10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "BMW",
    "shortDescription": "BMW-branded ping pong",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
